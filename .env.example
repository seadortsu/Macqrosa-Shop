# =============================================================================
# MACQROSA LUXURY ATELIER — ENVIRONMENT CONFIGURATION
# =============================================================================

# Application
PORT=5000
NODE_ENV=development

# Database (Supabase PostgreSQL Connection String)
# For Vercel / serverless pooling, use port 6543 (aws-0-eu-central-1.pooler.supabase.com)
DATABASE_URL=postgresql://postgres.dyfvlvspogknoibkcoag:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Authentication (Separate secrets for customer and admin JWT tokens)
JWT_SECRET_CUSTOMER=change_me_customer_secret_2026
JWT_SECRET_ADMIN=change_me_admin_secret_2026

# Payment Gateway (Paystack — Card, Mobile Money, Apple Pay)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# Image Storage (Cloudinary — for cloud uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Transactional Emails (SMTP / Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM="Macqrosa Luxury Atelier" <noreply@macqrosa.shop>
